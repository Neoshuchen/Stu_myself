DJANGO_ENV=production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=learn.example.com
DJANGO_SECURE_SSL=1
CSRF_TRUSTED_ORIGINS=https://learn.example.com
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_HSTS_PRELOAD=0
MYSQL_DATABASE=zhixu
MYSQL_USER=zhixu
MYSQL_HOST=db
MYSQL_PORT=3306
CORS_ALLOWED_ORIGINS=
AI_ASSISTANT_ENABLED=0
AI_REDIS_URL=redis://redis:6379/0
AI_CUSTOM_ALLOWED_HOSTS=
AI_OPENAI_MODELS=gpt-5.6-luna,gpt-5.6-terra
AI_ANTHROPIC_MODELS=claude-haiku-4-5,claude-sonnet-5
AI_REQUEST_TIMEOUT_SECONDS=45
AI_PROVIDER_RESPONSE_MAX_BYTES=8388608
AI_CONTEXT_CACHE_TTL_SECONDS=900
AI_ATTACHMENT_CACHE_TTL_SECONDS=3600
AI_CONTEXT_CHAR_BUDGET=32000
AI_MESSAGE_MAX_CHARS=6000
AI_RESPONSE_MAX_CHARS=50000
AI_ATTACHMENT_MAX_BYTES=4194304
AI_ATTACHMENT_MAX_FILES=2
AI_ATTACHMENT_TEXT_MAX_CHARS=12000
AI_PDF_MAX_PAGES=20
AI_IMAGE_CONTEXT_MAX_BYTES=8388608
THROTTLE_AI_CHAT=30/min
THROTTLE_AI_CREDENTIAL=10/hour
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=知序 <noreply@example.com>
TENCENT_SES_REGION=ap-hongkong
TENCENT_SES_TEMPLATE_ID=0
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_COOLDOWN_SECONDS=60
EMAIL_CODE_IP_LIMIT_PER_HOUR=20
INVITE_ONLY_REGISTRATION=1
MEDIA_URL_TTL_SECONDS=600
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
PIP_INDEX_URL=https://pypi.org/simple
